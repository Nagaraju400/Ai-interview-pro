# ==========================================
# AI Interview Simulator - Environment Variables
# Copy this file to `.env.local` or `.env` and fill in your values
# ==========================================

# -----------------
# App Configuration
# -----------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------
# Database (PostgreSQL / Supabase)
# -----------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_interview_db?sslmode=disable"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ai_interview_db?sslmode=disable"

# -----------------
# Supabase Authentication & Storage
# -----------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------
# Admin Portal & Auth
# -----------------
ADMIN_EMAIL="admin@example.com"
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"
ADMIN_JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# -----------------
# AI Models (Gemini / Groq / OpenAI)
# -----------------
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
OPENAI_API_KEY="your-openai-api-key"

# -----------------
# Payment Gateway (Razorpay)
# -----------------
RAZORPAY_KEY_ID="rzp_test_yourkeyid"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourkeyid"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# -----------------
# Redis Cache & Session Memory
# -----------------
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------
# Email Service (Resend)
# -----------------
RESEND_API_KEY="re_your_resend_api_key"
